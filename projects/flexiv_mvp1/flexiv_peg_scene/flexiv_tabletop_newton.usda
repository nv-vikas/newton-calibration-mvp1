    def Xform "HoleBlock" (
        prepend references = @assets/HoleBlock.usd@
    )
    {
        double3 xformOp:translate = (0.15, 0, 0.75)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Collision" (
            prepend apiSchemas = ["PhysxCollisionAPI"]
        )
        {
            float physxCollision:contactOffset = 0.00005
            float physxCollision:restOffset = 0
        }
    }

    def Xform "Robot" (
        prepend references = @assets/Flexiv_Rizon4s_Grav.usd@
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 8
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.44999998807907104, 0, 0.7649999856948853)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "joints"
        {
            over "root_joint"
            {
                point3f physics:localPos0 = (-0.45, 0, 0.765)
            }

            over "joint1" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:targetPosition = 8.468785
            }

            over "joint2" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
